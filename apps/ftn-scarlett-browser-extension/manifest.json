{
  "manifest_version": 3,
  "name": "Scarlett by FTN",
  "short_name": "Scarlett",
  "version": "0.2.0",
  "description": "A local-first adaptive interface layer that helps you work with the page you are on while preserving the original.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://ftnplatform.org/ibis-ai/*",
    "https://www.ftnplatform.org/ibis-ai/*",
    "https://ftnplatform.org/ibis-headspace-preview/*",
    "https://www.ftnplatform.org/ibis-headspace-preview/*"
  ],
  "optional_permissions": [
    "webRequest",
    "declarativeNetRequest"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Scarlett",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/scarlett-16.png",
      "32": "icons/scarlett-32.png",
      "48": "icons/scarlett-48.png",
      "128": "icons/scarlett-128.png"
    }
  },
  "icons": {
    "16": "icons/scarlett-16.png",
    "32": "icons/scarlett-32.png",
    "48": "icons/scarlett-48.png",
    "128": "icons/scarlett-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ftnplatform.org/ibis-ai/*",
        "https://www.ftnplatform.org/ibis-ai/*",
        "https://ftnplatform.org/ibis-headspace-preview/*",
        "https://www.ftnplatform.org/ibis-headspace-preview/*"
      ],
      "js": [
        "ibis-handoff.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://ftnplatform.org/*",
      "https://www.ftnplatform.org/*"
    ]
  }
}
